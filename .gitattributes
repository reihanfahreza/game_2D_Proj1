# .gitattributes (folder utama repository) - file besar lewat Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text

# File teks Unity (YAML) tetap teks biasa
*.cs text diff=csharp
*.unity text
*.prefab text
*.asset text
*.meta text
*.anim text
*.controller text
*.overrideController text

# Gambar dokumentasi README (Docs/) disimpan sebagai file git biasa agar selalu tampil di GitHub
Docs/** !filter !diff !merge -text
